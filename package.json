{
  "name": "youtube-tts-bot",
  "private": true,
  "scripts": {
    "dev": "bun run dev.ts",
    "dev:backend": "cd backend && python3.12 -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
    "dev:frontend": "cd frontend && bun dev",
    "build": "cd frontend && bun run build",
    "start:backend": "cd backend && python3.12 -m uvicorn main:app --host 0.0.0.0 --port 8000",
    "start:frontend": "cd frontend && bun start"
  }
}
