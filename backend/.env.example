# Optional - defaults work for local development

# HOST=0.0.0.0
# PORT=8000
# CORS_ORIGINS=http://localhost:3000

# 60db TTS provider (required only when tts_provider = "60db").
# The ElevenLabs key is entered in the dashboard; the 60db key is read here.
# SIXTYDB_API_KEY=your-60db-api-key
# Optional 60db overrides:
# SIXTYDB_WS_URL=ws://api.60db.ai/ws/tts
# SIXTYDB_VOICE_ID=fbb75ed2-975a-40c7-9e06-38e30524a9a1
# SIXTYDB_SAMPLE_RATE=24000
